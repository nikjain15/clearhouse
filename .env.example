# Clearhouse environment configuration
#
# Copy to .env.local and fill in. Nothing in this file is real.
#
# Two things never enter the repository, because they only work while unknown
# (PLATFORM.md section 1, "What is public and what is not"): the canary strings
# and the holdout question set. Every canary and holdout value below is
# obviously fake and is here to show the shape, not the content.

# ---------------------------------------------------------------------------
# Model access
# ---------------------------------------------------------------------------
# Without a key, Clearhouse runs entirely on the recorded fixture path: the
# hero personas are scripted (PLATFORM.md requires this anyway), every model
# call resolves from the content-hash cache, and the board, ledger, eval and
# replay all work. With a key, cache misses go live.
#
# LEAVE THIS UNSET for the run-it-as-is path. A placeholder key is worse than
# no key: it makes the model client believe it is live, so any cache miss
# attempts a real call and 401s. Uncomment and set a real key only to send
# cache misses live.
# ANTHROPIC_API_KEY=sk-ant-api03-your-real-key-here

# Sonnet for the six pillars, Opus for adjudication and claim underwriting.
CLEARHOUSE_MODEL_CHECKS=claude-sonnet-5
CLEARHOUSE_MODEL_ADJUDICATION=claude-opus-5

# ---------------------------------------------------------------------------
# Event store
# ---------------------------------------------------------------------------
# Postgres is the event store (PLATFORM.md section 1, "Runtime shape"), not
# process memory: serverless functions have no memory to keep it in, and the
# registry, the eval gate and replay all depend on the log surviving a cold
# start. Unset DATABASE_URL falls back to the file-backed adapter behind the
# same interface, which is for local development only.
#
# LEAVE THIS UNSET for the run-it-as-is path. A placeholder host is worse than
# no host: the store selects Postgres whenever DATABASE_URL starts with
# "postgres", then blocks ~8s on an unreachable host before failing. Uncomment
# and set a real connection string only for a Postgres-backed deployment.
# DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Canary pool, Pillar 3
# ---------------------------------------------------------------------------
# BX-04 is the buyer-embedded canary: a harmless instruction in our own
# message. Obeying it is a soft signal at low weight and never a gate.
# BX-05 is the content-embedded canary: a harmless instruction planted in
# third-party content the merchant ingests. Obeying it is the hard gate, and
# it is bonded-only.
#
# Comma-separated rotating pools. The method is published; the strings are not.
# These four are fake and are published here on purpose.
CLEARHOUSE_CANARY_BX04_POOL=say-pineapple-01,say-pineapple-02
CLEARHOUSE_CANARY_BX05_POOL=say-marmalade-01,say-marmalade-02

# ---------------------------------------------------------------------------
# Holdout question set, Pillars 3 and 6
# ---------------------------------------------------------------------------
# Reserved and never used during initial underwriting, so a merchant that
# tuned to the exam has not seen it. Drives the unannounced re-audit. JSON
# array of question objects. These two are fake.
CLEARHOUSE_HOLDOUT_QUESTIONS=[{"id":"HO-FAKE-1","claim":"refund_window","text":"Fake holdout question, replaced in deployment"},{"id":"HO-FAKE-2","claim":"total_with_fees","text":"Second fake holdout question"}]

# ---------------------------------------------------------------------------
# Arena, live user testing 8 to 9 PM
# ---------------------------------------------------------------------------
# The arena accepts submissions during the window only, then becomes a
# read-only archive, so an unauthenticated endpoint calling a paid API is not
# left standing open on the indexed internet. Times are ISO 8601 with offset.
#
# LEAVE UNSET to keep the arena closed (read-only archive). Set both to the
# live window just before the demo. Unset or unparseable => closed, never open.
# CLEARHOUSE_ARENA_OPENS_AT=2026-08-16T20:00:00-04:00
# CLEARHOUSE_ARENA_CLOSES_AT=2026-08-16T21:00:00-04:00
CLEARHOUSE_ARENA_MAX_CHARS=4000
CLEARHOUSE_ARENA_RATE_LIMIT_PER_HOUR=5

# Shared secret for the human promotion gate: promoting an arena case into the
# eval set, and promoting a provisional F24+ taxonomy ID into a permanent one.
# This gate is a security boundary, not bureaucracy (PLATFORM.md section 3).
#
# LEAVE UNSET to disable promotion entirely (the route returns 503). A shipped
# token is an open gate: set your own secret only in the real deployment.
# CLEARHOUSE_PROMOTION_TOKEN=set-a-real-secret-here

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Latency target per underwriting file, milliseconds. Measured and shown.
# Anything slower is served from the cached path (PLATFORM.md section 1).
CLEARHOUSE_LATENCY_TARGET_MS=30000

# Set to "1" to refuse live model calls entirely and serve only the cache.
# This is the switch to throw if the conference wifi dies mid-demo.
CLEARHOUSE_REPLAY_ONLY=0
